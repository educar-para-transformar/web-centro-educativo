rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección users (Perfiles de padres, administradores, etc.)
    match /users/{userId} {
      // Bloquear escrituras directas desde el cliente.
      // Todas las altas y modificaciones deben ocurrir a través de las Cloud Functions.
      allow write: if false;
      
      // Permitir lectura si:
      // 1. El usuario autenticado es dueño de su propio perfil.
      // 2. El usuario autenticado posee el rol 'user_admin' en sus Custom Claims.
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.role == 'user_admin'
      );
    }
    
    // Colección students (Datos y login de alumnos)
    match /students/{studentId} {
      // Bloquear escrituras directas desde el cliente.
      allow write: if false;
      
      // Permitir lectura si:
      // 1. El usuario es el propio alumno (su UID coincide con el ID de documento).
      // 2. El usuario es el padre asociado (su UID coincide con el parentId del alumno).
      // 3. El usuario posee el rol 'user_admin' en sus Custom Claims.
      allow read: if request.auth != null && (
        request.auth.uid == studentId || 
        resource.data.parentId == request.auth.uid || 
        request.auth.token.role == 'user_admin'
      );
    }

    // Colección materias (Materias curriculares)
    match /materias/{materiaId} {
      // Las escrituras se realizan solo a través de las Cloud Functions.
      allow write: if false;

      // Lectura pública de catálogo de materias para usuarios autenticados.
      allow read: if request.auth != null;
    }

    // Colección calificaciones (Notas del alumno por materia y trimestre)
    match /calificaciones/{calificacionId} {
      // Las escrituras se realizan solo a través de las Cloud Functions.
      allow write: if false;

      // Lectura:
      // 1. El propio alumno puede leer sus calificaciones.
      // 2. El user_admin puede leer todas.
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        request.auth.token.role == 'user_admin'
      );
    }

    // Colección asistencias (Registro de asistencia por alumno, materia y fecha)
    match /asistencias/{asistenciaId} {
      // Las escrituras se realizan solo a través de las Cloud Functions.
      allow write: if false;

      // Lectura: el propio alumno, su tutor, o un administrador.
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        request.auth.token.role == 'user_admin' ||
        (exists(/databases/$(database)/documents/students/$(resource.data.studentId)) &&
         get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.parentId == request.auth.uid)
      );
    }

    // Colección horarios (Bloques horarios por nivel/curso)
    match /horarios/{horarioId} {
      // Las escrituras se realizan solo a través de las Cloud Functions.
      allow write: if false;

      // Lectura para usuarios autenticados de la comunidad educativa.
      allow read: if request.auth != null;
    }

    // Colección materiales (Materiales de estudio por materia)
    match /materiales/{materialId} {
      // Las escrituras se realizan solo a través de las Cloud Functions.
      allow write: if false;

      // Lectura para usuarios autenticados de la comunidad educativa.
      allow read: if request.auth != null;
    }

    // Colección passwordResets (Tokens de recuperación de contraseña)
    match /passwordResets/{tokenHash} {
      // Acceso exclusivo desde Cloud Functions con Admin SDK.
      allow read, write: if false;
    }

    // Colección news (Noticias del portal)
    match /news/{newsId} {
      // Las noticias son públicas para que cualquier visitante del sitio pueda leerlas
      allow read: if true;
      
      // Solo administradores autenticados (con claim de admin o perfil en la bd con rol user_admin) pueden escribir
      allow write: if request.auth != null && (
        request.auth.token.role == 'user_admin' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user_admin')
      );
    }
  }
}
