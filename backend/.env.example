# Firebase Admin: JSON de la service account codificado en base64.
# En local se puede usar JSON pegado directamente o dejar vacío con los emuladores.
FIREBASE_SERVICE_ACCOUNT=

# Solo para emuladores locales.
GCLOUD_PROJECT=centro-educativo-f5cc5
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Dominios permitidos por CORS, separados por coma.
ALLOWED_ORIGINS=http://localhost:5173

# Brevo/Resend SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Educar para Transformar" <no-reply@tudominio.com>

# Enlaces de activación y restablecimiento.
APP_BASE_URL=http://localhost:5173
REDIRECT_URL=http://localhost:5173/auth-action

# Protección del cron diario.
CRON_SECRET=dev-secret
